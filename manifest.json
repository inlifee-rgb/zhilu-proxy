{
  "manifest_version": 3,
  "name": "智路 · CN 智能分流代理",
  "version": "1.2.3",
  "description": "中国网址与 IP 直连，海外流量全部走代理。由 Chrome 内置 PAC 接管，不依赖 Clash 的系统代理开关。",
  "minimum_chrome_version": "110",
  "permissions": [
    "proxy",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://www.cloudflare.com/*",
    "https://myip.ipip.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "智路 · CN 智能分流代理",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
